# =================================================================
# ApniLeap Global Environment Configuration (.env.example)
# Copy this file to .env before starting the platform: cp .env.example .env
# =================================================================

NODE_ENV=development
LOG_LEVEL=info

# Security: Set a secure, random secret (at least 16 characters)
# In production, default or placeholder secrets ('changeme', 'secret', etc.) will cause the system to fail-fast.
JWT_SECRET=replace-with-secure-random-jwt-secret-at-least-16-chars
INTERNAL_SERVICE_SECRET=replace-with-secure-random-service-secret-at-least-16-chars

# Ports
ELIGIBILITY_PORT=3001
RANKING_PORT=3002
DATA_ENGINE_PORT=3003
BFF_PORT=3004
WEB_PORT=5173

# Internal Service URLs
ELIGIBILITY_URL=http://localhost:3001
RANKING_URL=http://localhost:3002
DATA_ENGINE_URL=http://localhost:3003
BFF_URL=http://localhost:3004

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3004

# Storage
DATA_DIR=./data

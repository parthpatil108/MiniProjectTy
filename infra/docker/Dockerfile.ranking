# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json tsconfig.base.json ./
COPY packages ./packages
COPY services/ranking ./services/ranking

RUN npm ci --workspace=@apnileap/common --workspace=@apnileap/ranking
RUN npm run build --workspace=@apnileap/common
RUN npm run build --workspace=@apnileap/ranking

# Stage 2: Runner
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
COPY packages ./packages
COPY services/ranking/package.json ./services/ranking/package.json

RUN npm ci --omit=dev --workspace=@apnileap/common --workspace=@apnileap/ranking

COPY --from=builder /app/packages/common/dist ./packages/common/dist
COPY --from=builder /app/services/ranking/dist ./services/ranking/dist

USER node
EXPOSE 3002

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3002/healthz || exit 1

CMD ["node", "services/ranking/dist/server.js"]

{
  "name": "team-d-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:ui": "vite",
    "dev:server": "tsx watch server.ts",
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}

{
  "name": "@placement-platform/team-b",
  "version": "1.0.0",
  "private": true,
  "description": "Team B Ranking and Shortlisting Analytics Engine",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "demo:b1": "npm run build && node dist/src/demo/b1Demo.js",
    "demo:b2": "npm run build && node dist/src/demo/b2Demo.js",
    "test:b1": "npm run build && node --test dist/test/b1Graph.test.js",
    "test:b2": "npm run build && node --test dist/test/b2Ranking.test.js",
    "test": "npm run build && node --test dist/test/b1Graph.test.js dist/test/b2Ranking.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0"
  }
}

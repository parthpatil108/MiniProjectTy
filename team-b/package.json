{
  "name": "@placement-platform/team-b",
  "version": "1.0.0",
  "private": true,
  "description": "Team B Ranking and Shortlisting Analytics Engine",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "ts-node-dev src/server.ts",
    "demo:b1": "npm run build && node dist/src/demo/b1Demo.js",
    "demo:b2": "npm run build && node dist/src/demo/b2Demo.js",
    "demo:b3": "npm run build && node dist/src/demo/b3Demo.js",
    "demo:b4": "npm run build && node dist/src/demo/b4Demo.js",
    "test:b1": "npm run build && node --test dist/test/b1Graph.test.js",
    "test:b2": "npm run build && node --test dist/test/b2Ranking.test.js",
    "test:b3": "npm run build && node --test dist/test/b3Index.test.js",
    "test:b4": "npm run build && node --test dist/test/b4Analytics.test.js",
    "test": "npm run build && node --test dist/test/b1Graph.test.js dist/test/b2Ranking.test.js dist/test/b3Index.test.js dist/test/b4Analytics.test.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "uuid": "^14.0.2"
  }
}
